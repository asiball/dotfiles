#!/usr/bin/env bash
# Claude Code 用の tmux ワークスペースを起動する(既にあれば再接続)
#
#   tmux-claude [-l 2|4] [-c] [dir] [-- claude の引数...]
#     dir   省略時はカレントディレクトリ。セッション名はディレクトリ名
#     -l 2  左 claude(65%) / 右シェル            (既定)
#     -l 4  2x2。左上 claude、他 3 つはシェル
#     -c    claude --continue で前回の会話を再開
#     --    以降は claude にそのまま渡す(例: -- -w feature-x、-- --resume 名前)
#   tmux-claude -L        セッション一覧
#   tmux-claude -k [dir]  dir のセッションを終了
#   どのレイアウトも window "shell"(作業用シェル)を別に作る。
#   既存セッションに再接続するときはレイアウト・claude 引数は無視される。
set -eu

usage() { sed -n '2,14p' "$0"; exit "${1:-0}"; }

layout=2 claude_args=() action=open
while getopts 'l:cLkh' opt; do
    case "$opt" in
        l) layout="$OPTARG" ;;
        c) claude_args+=(--continue) ;;
        L) action=list ;;
        k) action=kill ;;
        h) usage ;;
        *) usage 1 ;;
    esac
done
shift $((OPTIND - 1))
case "$layout" in 2|4) ;; *) echo "レイアウトは 2 か 4 を指定してください" >&2; usage 1 ;; esac

if [ "$action" = list ]; then
    tmux ls -F '#{session_name}  #{session_windows}w  #{?session_attached,attached,-}  #{session_path}' 2>/dev/null || echo "セッションはありません"
    exit 0
fi

# dir と claude 引数(-- 以降)を分ける
dir=.
if [ $# -gt 0 ] && [ "$1" != "--" ]; then dir="$1"; shift; fi
if [ $# -gt 0 ] && [ "$1" = "--" ]; then shift; claude_args+=("$@"); fi
dir="$(cd "$dir" && pwd)"
name="$(basename "$dir" | sed 's/[^A-Za-z0-9_-]/_/g')"   # セッション名に使えない . : を置換

if [ "$action" = kill ]; then
    tmux kill-session -t "=$name" && echo "終了: $name"
    exit 0
fi

if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$dir" -n claude
    if [ "$layout" = 4 ]; then
        tmux split-window -h -t "$name:claude" -c "$dir"
        tmux split-window -v -t "$name:claude.1" -c "$dir"
        tmux split-window -v -t "$name:claude.3" -c "$dir"
        tmux select-layout -t "$name:claude" tiled
    else
        tmux split-window -h -l 35% -t "$name:claude" -c "$dir"
    fi
    tmux new-window -d -t "$name" -n shell -c "$dir"
    tmux send-keys -t "$name:claude.1" "claude${claude_args[*]:+ ${claude_args[*]}}" C-m
    tmux select-pane -t "$name:claude.1"
fi

if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$name"
else
    tmux attach-session -t "=$name"
fi
