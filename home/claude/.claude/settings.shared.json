{
  "preferredNotifChannel": "terminal_bell",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.mjs",
    "padding": 2
  },
  "model": "fable",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-fable-5-1": {
      "autoCompactWindow": 400000
    }
  },
  "advisorModel": "fable",
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:ja-proofread": "off",
    "anthropic-skills:skill-creator": "off"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "asiball/claude-kit"
      }
    }
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "codex@openai-codex": true,
    "cc-plugin-you-should-know@builtin": true,
    "ship-check@claude-kit": true,
    "playful@claude-kit": true,
    "obi@claude-kit": true
  },
  "feedbackDrafts": "off",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true
}
